PORT=4000
NODE_ENV=development

POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

LOCAL_ADMIN_EMAIL=admin@local
LOCAL_ADMIN_PASSWORD=change-me-please
LOCAL_ADMIN_DISPLAY_NAME=Local Admin

LDAP_URL=ldaps://ad.company.com:636
LDAP_BASE_DN=DC=company,DC=com
LDAP_SEARCH_BASE=DC=company,DC=com
LDAP_BIND_DN=CN=svc-ldap,OU=Service Accounts,DC=company,DC=com
LDAP_BIND_PASSWORD=change-me-please
LDAP_ALLOWED_GROUPS=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TLS_CA_FILE=
LDAP_TLS_CA_BASE64=
